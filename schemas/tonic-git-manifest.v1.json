{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merge.tonic/schemas/tonic-git-manifest.v1.json",
  "title": "TonicGitManifestV1",
  "type": "object",
  "required": ["schema", "version", "commit", "paths"],
  "properties": {
    "schema": { "const": "tonic-git-manifest" },
    "version": { "type": "string", "const": "1" },
    "commit": { "type": "string", "description": "Git commit SHA (hex)" },
    "diff_engine_id": { "type": "string", "description": "Engine id for replay/merge compatibility" },
    "weave_format_version": { "type": "string", "description": "Serialized weave format version" },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["text_blob_sha", "weave_serialized_sha", "weave_format_version", "diff_engine_id"],
        "properties": {
          "text_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 hex of canonical UTF-8 text (LF)"
          },
          "weave_serialized_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 hex of serialized weave state bytes (UTF-8)"
          },
          "weave_format_version": { "type": "string" },
          "diff_engine_id": { "type": "string" },
          "parent_weave_shas": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "description": "Parent weave SHAs for merge commits (order: first parent, second, ...)"
          },
          "degraded": { "type": "boolean", "description": "True if merge used snapshot-only fallback" },
          "squash": { "type": "boolean", "description": "True if commit is squash / non-replayable parent chain" },
          "weave_object_key": {
            "type": "string",
            "description": "Optional content-addressed key (LFS oid or Hub key) for serialized weave blob"
          },
          "replay_trace_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Optional CTRD id (sha256) for Hub trace .tonic/hub/traces/{replay_trace_key}.json"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
