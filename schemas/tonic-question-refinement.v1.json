{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merge.tonic/schemas/tonic-question-refinement.v1.json",
  "title": "TonicQuestionRefinementV1",
  "type": "object",
  "required": ["schema", "version", "mode"],
  "properties": {
    "schema": { "const": "tonic-question-refinement" },
    "version": { "type": "string", "const": "1" },
    "mode": { "type": "string", "enum": ["off", "improver", "subquestions"] },
    "refined_left_intent": { "type": "string" },
    "refined_right_intent": { "type": "string" },
    "merge_goals": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "subquestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "priority": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "model_id": { "type": "string" },
    "prompt_template_ids": { "type": "array", "items": { "type": "string" } },
    "context_digest_sha256": { "type": "string" }
  },
  "additionalProperties": false
}
