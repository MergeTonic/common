{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merge.tonic/schemas/tonic-weave-verify-report.v1.json",
  "title": "TonicWeaveVerifyReportV1",
  "type": "object",
  "required": ["schema", "version", "status", "repo_root", "checks"],
  "properties": {
    "schema": { "const": "tonic-weave-verify-report" },
    "version": { "type": "string", "const": "1" },
    "status": { "type": "string", "enum": ["ok", "failed", "degraded"] },
    "strict": { "type": "boolean" },
    "repo_root": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ok"],
        "properties": {
          "id": { "type": "string" },
          "ok": { "type": "boolean" },
          "message": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
