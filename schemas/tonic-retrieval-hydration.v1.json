{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merge.tonic/schemas/tonic-retrieval-hydration.v1.json",
  "title": "TonicRetrievalHydrationV1",
  "type": "object",
  "required": ["schema", "version", "hits"],
  "properties": {
    "schema": { "const": "tonic-retrieval-hydration" },
    "version": { "type": "string", "const": "1" },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "text", "score"],
        "properties": {
          "chunk_id": { "type": "string" },
          "text": { "type": "string" },
          "score": { "type": "number" },
          "metadata": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "start_line": { "type": "integer" },
              "end_line": { "type": "integer" },
              "source": { "type": "string", "enum": ["vector", "lexical", "hybrid", "memory"] },
              "ast_rule_id": { "type": "string" },
              "ast_match_id": { "type": "string" },
              "ast_boost_applied": { "type": "number" },
              "nearest_conflict_region_id": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
