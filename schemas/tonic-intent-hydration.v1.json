{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merge.tonic/schemas/tonic-intent-hydration.v1.json",
  "title": "TonicIntentHydrationV1",
  "type": "object",
  "required": ["schema", "version", "left_intent", "right_intent"],
  "properties": {
    "schema": { "const": "tonic-intent-hydration" },
    "version": { "type": "string", "const": "1" },
    "left_intent": { "type": "string" },
    "right_intent": { "type": "string" },
    "truncation_policy_version": { "type": "string" },
    "token_budget_hint": { "type": "integer" },
    "conflict_region_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["ast_match", "retrieval_hit", "code_walk", "conflict"] },
          "path": { "type": "string" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "prompt_excerpt": { "type": "string" }
  },
  "additionalProperties": true
}
