{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merge.tonic/schemas/tonic-hydration-pipeline.v1.json",
  "title": "TonicHydrationPipeline",
  "type": "object",
  "required": [
    "schema",
    "pipeline_version",
    "run_id",
    "repo_root",
    "persist_root",
    "vector_backend",
    "run_status",
    "stages",
    "artifacts"
  ],
  "properties": {
    "schema": { "const": "tonic-hydration-pipeline" },
    "pipeline_version": { "type": "string", "pattern": "^1(\\.[0-9]+)?$" },
    "run_id": { "type": "string", "minLength": 1 },
    "repo_root": { "type": "string", "minLength": 1 },
    "persist_root": { "type": "string", "minLength": 1 },
    "vector_backend": {
      "type": "string",
      "enum": ["chroma-http", "chroma-persistent", "ephemeral", "memory"]
    },
    "run_status": {
      "type": "string",
      "enum": ["planned", "running", "completed", "skipped", "failed"]
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stageState" }
    },
    "artifacts": {
      "type": "object",
      "required": ["index_state_path", "run_state_path"],
      "properties": {
        "index_state_path": { "type": "string", "minLength": 1 },
        "run_state_path": { "type": "string", "minLength": 1 },
        "branch_intents_path": { "type": "string" },
        "question_plan_path": { "type": "string" },
        "hydration_cycle_path": { "type": "string" },
        "retrieval_path": { "type": "string" },
        "retrieval_merge_path": { "type": "string" },
        "metadata_consolidation_path": { "type": "string" },
        "hydration_result_path": { "type": "string" },
        "llm_transcript_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "branch_intents": {
      "$ref": "tonic-intent-hydration.schema.json#/$defs/branchIntentCollection"
    },
    "question_plan": {
      "$ref": "tonic-intent-hydration.schema.json#/$defs/questionPlan"
    },
    "hydration_cycle": {
      "$ref": "tonic-intent-hydration.schema.json#/$defs/hydrationCycle"
    },
    "question_slots": {
      "type": "array",
      "items": { "$ref": "tonic-intent-hydration.schema.json#/$defs/questionSlot" }
    },
    "retrieval_bundles": {
      "type": "array",
      "items": { "$ref": "tonic-intent-hydration.schema.json#/$defs/retrievalBundle" }
    },
    "retrieval_merge": {
      "$ref": "tonic-intent-hydration.schema.json#/$defs/retrievalMerge"
    },
    "metadata_consolidation": {
      "$ref": "tonic-intent-hydration.schema.json#/$defs/metadataConsolidation"
    }
  },
  "$defs": {
    "stageState": {
      "type": "object",
      "required": ["stage_id", "status"],
      "properties": {
        "stage_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "completed", "skipped", "failed"]
        },
        "content_hash": { "type": "string" },
        "started_at": { "type": "string" },
        "finished_at": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
